import tkinter as tk

# Create main window
window = tk.Tk()
window.title("Square on Canvas")
window.geometry("400x400")

# Create canvas
canvas = tk.Canvas(window, width=300, height=300, bg="white")
canvas.pack(pady=20)

# Draw square (x1, y1, x2, y2)
canvas.create_rectangle(50, 50, 200, 200, outline="black", fill="lightblue")

# Run window
window.mainloop()
