rows = 5

print("Right Triangle:")
for i in range(1, rows + 1):
    print("*" * i)

print("\nInverted Right Triangle:")
for i in range(rows, 0, -1):
    print("*" * i)

print("\nPyramid:")
for i in range(rows):
    print(" " * (rows - i - 1) + "*" * (2 * i + 1))

print("\nInverted Pyramid:")
for i in range(rows, 0, -1):
    print(" " * (rows - i) + "*" * (2 * i - 1))

print("\nSquare:")
for i in range(rows):
    print("*" * rows)
