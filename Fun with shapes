import turtle
import random

# Setup screen
screen = turtle.Screen()
screen.bgcolor("black")

pen = turtle.Turtle()
pen.speed(0)
pen.width(2)

colors = ["red", "orange", "yellow", "green", "blue", "purple", "pink", "cyan"]

# Function to draw polygon
def draw_shape(sides, size):
    angle = 360 / sides
    for _ in range(sides):
        pen.forward(size)
        pen.right(angle)

# Draw multiple random shapes
for _ in range(20):
    pen.penup()
    pen.goto(random.randint(-200, 200), random.randint(-200, 200))
    pen.pendown()
    
    pen.pencolor(random.choice(colors))
    sides = random.randint(3, 8)   # triangle to octagon
    size = random.randint(30, 80)
    
    draw_shape(sides, size)

turtle.done()
